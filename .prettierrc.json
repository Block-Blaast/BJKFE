{
  "singleQuote": true,
  "trailingComma": "all",
  "tabWidth": 2,
  "semi": true,
  "useTabs": false,
  "printWidth": 100,
  "arrowParens": "always",
  "plugins": ["prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": ["apps/web/**", "packages/ui/**"],
      "options": {
        "tailwindStylesheet": "./apps/web/src/app/globals.css"
      }
    }
  ]
}
