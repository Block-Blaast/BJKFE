{
  "singleQuote": true,
  "trailingComma": "all",
  "tabWidth": 2,
  "semi": true,
  "useTabs": false,
  "printWidth": 100,
  "arrowParens": "always",
  "plugins": ["prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": "apps/user/**",
      "options": { "tailwindStylesheet": "./apps/user/src/app/globals.css" }
    },
    {
      "files": "apps/admin/**",
      "options": { "tailwindStylesheet": "./apps/admin/src/app/globals.css" }
    }
  ]
}
