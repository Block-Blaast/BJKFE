{
  "name": "bjkfe",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:user": "turbo run dev --filter=@bjk/user",
    "dev:admin": "turbo run dev --filter=@bjk/admin",
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm lint:design",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "lint:design": "node scripts/lint-design.mjs && node scripts/verify-tokens.mjs"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.16.1",
  "lint-staged": {
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ],
    "scripts/**/*.mjs": [
      "prettier --write"
    ]
  }
}
