  },
  "devDependencies": {
    "@bjk/config": "workspace:*",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "next": "^16.4.4",
    "react": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "next": "^16.4.4",
    "react": "^19.3.0"
  }
